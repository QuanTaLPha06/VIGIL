# ─────────────────────────────────────────────
# VIGIL — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control
# ─────────────────────────────────────────────

# ── Firebase Client SDK (apps/web — browser) ──
# Firebase Console → Project Settings → Your apps → Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Firebase Admin SDK (API routes — server only) ─
# Firebase Console → Project Settings → Service accounts → Generate new private key
# Then extract these three values from the downloaded JSON file:
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── Groq AI (API routes — server only) ────────
# Free tier, no credit card: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# ── Blockchain / DealLock ─────────────────────
# Base Sepolia testnet RPC — free, no signup needed
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Fresh MetaMask test wallet — NEVER use a real funded wallet
PRIVATE_KEY=your_test_wallet_private_key
# Set after running: pnpm blockchain:deploy
NEXT_PUBLIC_DEALLOCK_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── App Config ────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
