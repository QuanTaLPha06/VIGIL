# ─────────────────────────────────────────────
# VIGIL — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control
# ─────────────────────────────────────────────

# ── Firebase Client SDK (apps/web) ────────────
# Get these from: Firebase Console → Project Settings → Your apps → Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Firebase Admin SDK (functions/) ───────────
# Used only for local dev — Cloud Functions use the default service account automatically.
# Download from: Firebase Console → Project Settings → Service accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccount.json

# ── Groq AI (functions/scam-checker, cases) ───
# Free tier — no credit card needed: https://console.groq.com/keys
# Models: llama-3.3-70b-versatile (default) | llama-3.1-8b-instant (faster)
GROQ_API_KEY=your_groq_api_key

# ── Blockchain / DealLock ─────────────────────
# Base Sepolia testnet RPC — free, no signup needed
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Test wallet private key — create a fresh MetaMask wallet for this, NEVER use a real wallet
PRIVATE_KEY=your_test_wallet_private_key
# Set this AFTER running: pnpm blockchain:deploy
NEXT_PUBLIC_DEALLOCK_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── App Config ────────────────────────────────
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_FUNCTIONS_BASE_URL=http://localhost:5001/your_project_id/us-central1
