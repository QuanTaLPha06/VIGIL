rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Development rules ─────────────────────────────────────
    // Any authenticated user can read/write their own data.
    // TODO: tighten these rules before production deployment.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
